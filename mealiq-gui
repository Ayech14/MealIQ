#!/bin/sh
# Starts the MealIQ desktop app from the project folder: ./mealiq-gui
set -e
cd "$(dirname "$0")"
./mvnw -q compile dependency:build-classpath -Dmdep.outputFile=target/classpath.txt
exec java -cp "target/classes:$(cat target/classpath.txt)" io.github.ayech14.mealiq.presentation.gui.MealIQDesktop "$@"
