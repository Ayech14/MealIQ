# .env.example - contains no real credentials.
# Copy to .env and fill in local values: cp .env.example .env

# Database (matches docker-compose.yml)
POSTGRES_USER=mealiq
POSTGRES_PASSWORD=CHANGE_ME_LOCAL_DB_PASSWORD
POSTGRES_DB=mealiq
DATABASE_URL=postgresql+psycopg://mealiq:CHANGE_ME_LOCAL_DB_PASSWORD@localhost:5432/mealiq

# LLM provider
LLM_API_KEY=YOUR_LOCAL_API_KEY_HERE
# Use a dated model snapshot so behaviour does not change underneath the app.
LLM_MODEL=gpt-5.4-mini-2026-03-17
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2

# Agent tool-loop limit
MAX_TOOL_STEPS=6
