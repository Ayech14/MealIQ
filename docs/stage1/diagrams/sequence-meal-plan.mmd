sequenceDiagram
  actor User as Meal Planner
  participant UI as MealPlanningGUI or MealPlanningCLI
  participant F as MealPlanningFacade
  participant C as AgentController
  participant PR as ProfileRepository
  participant PA as PantryRepository
  participant A as MealPlanningAgent
  participant L as LLMClient
  participant LPA as ProviderLLMAdapter
  participant API as ExternalLLMProviderAPI
  participant TM as ToolManager
  participant RT as RecipeTool
  participant NS as NutritionService
  participant GS as GroceryService
  participant CV as ConstraintValidator
  participant MS as MealPlanService
  participant MR as MealPlanRepository
  User->>UI: generateWeeklyPlan(request)
  UI->>F: generateWeeklyPlan(request)
  F->>C: generateWeeklyPlan(request)
  C->>PR: findById(profileId)
  PR-->>C: UserProfile
  C->>PA: findByProfileId(profileId)
  PA-->>C: Pantry
  C->>A: createPlanProposal(context)
  A->>TM: execute("recipeSearch", criteria)
  TM->>RT: searchRecipes(criteria)
  RT-->>TM: compatible candidates
  TM-->>A: ToolResult(candidates)
  A->>L: generateStructured(planningPrompt, PlanningProposal schema)
  L->>LPA: generateStructured(prompt, schema)
  LPA->>API: createStructuredResponse(request)
  API-->>LPA: provider response
  LPA-->>L: StructuredResponse
  L-->>A: structured proposal data
  A-->>C: PlanningProposal
  C->>NS: calculateNutrition(proposal)
  NS-->>C: NutritionSummary
  C->>GS: generateList(proposal, pantry)
  GS-->>C: projected GroceryList
  C->>CV: validatePlan(proposal, context)
  alt valid and feasible
    CV-->>C: ValidationResult(valid)
    C->>MS: createFromProposal(proposal)
    MS->>MR: save(mealPlan)
    MR-->>MS: saved MealPlan
    MS-->>C: MealPlan
    C-->>F: plan + rationale + warnings
    F-->>UI: PlanResult
    UI-->>User: display weekly plan
  else missing critical information or infeasible
    CV-->>C: conflicts
    C-->>F: conflict alternatives
    F-->>UI: ConflictResult
    UI-->>User: request choice / show trade-offs
  end
