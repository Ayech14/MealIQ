sequenceDiagram
  actor User as Meal Planner
  participant UI as MealPlanningGUI or MealPlanningCLI
  participant F as MealPlanningFacade
  participant C as AgentController
  participant A as MealPlanningAgent
  participant L as LLMClient
  participant LPA as ProviderLLMAdapter
  participant API as ExternalLLMProviderAPI
  participant CV as ConstraintValidator
  participant MS as MealPlanService
  participant CMD as PlanChangeCommand
  participant GS as GroceryService
  User->>UI: "Make Wednesday dinner vegetarian"
  UI->>F: modifyPlan(planId, instruction)
  F->>C: interpretModification(plan, instruction)
  C->>A: proposeChange(context, instruction)
  A->>L: generateStructured(prompt, PlanChange schema)
  L->>LPA: generateStructured(prompt, schema)
  LPA->>API: createStructuredResponse(request)
  API-->>LPA: provider response
  LPA-->>L: StructuredResponse
  L-->>A: structured change
  A-->>C: PlanChange
  C->>CV: validatePlan(change, context)
  alt target unambiguous and change feasible
    CV-->>C: valid
    C-->>F: preview PlanChange
    F-->>UI: preview change
    User->>UI: confirm
    UI->>F: executeChange(planId, change)
    F->>MS: executeChange(plan, command)
    MS->>CMD: execute(plan)
    CMD-->>MS: updated plan
    MS->>GS: generateList(plan, pantry)
    GS-->>MS: refreshed GroceryList
    MS-->>F: updated MealPlan
    F-->>UI: updated result
  else ambiguous or invalid
    CV-->>C: clarification/conflicts
    C-->>F: clarification request or alternatives
    F-->>UI: no mutation
  end
