sequenceDiagram
  actor User as Meal Planner
  participant UI as MealPlanningGUI or MealPlanningCLI
  participant F as MealPlanningFacade
  participant C as AgentController
  participant MR as MealPlanRepository
  participant PR as PantryRepository
  participant GS as GroceryService
  participant BS as BudgetService
  participant A as MealPlanningAgent
  participant L as LLMClient
  participant LPA as ProviderLLMAdapter
  participant API as ExternalLLMProviderAPI
  participant ST as SubstitutionTool
  User->>UI: generateOptimizedGroceryList(planId)
  UI->>F: generateOptimizedGroceryList(planId)
  F->>MR: findActiveByProfileId(profileId)
  MR-->>F: MealPlan
  F->>PR: findByProfileId(profileId)
  PR-->>F: Pantry
  F->>GS: generateList(plan, pantry)
  GS-->>F: raw GroceryList
  F->>GS: optimizeList(rawList, prices)
  GS-->>F: consolidated GroceryList
  F->>BS: evaluate(list, budget)
  alt within budget
    BS-->>F: BudgetStatus(withinBudget)
    F-->>UI: GroceryList + estimate
    UI-->>User: display optimized list
  else over budget
    BS-->>F: BudgetStatus(shortfall)
    F->>C: adaptPlan(plan, budgetImpact)
    C->>A: proposeAdaptation(context, budgetImpact)
    A->>ST: findCandidates(ingredients, context)
    ST-->>A: substitutions
    A->>L: generateStructured(substitutionPrompt, PlanChange schema)
    L->>LPA: generateStructured(prompt, schema)
    LPA->>API: createStructuredResponse(request)
    API-->>LPA: provider response
    LPA-->>L: StructuredResponse
    L-->>A: structured substitution proposal
    A-->>C: PlanChange alternatives
    C-->>F: PlanChange alternatives
    F-->>UI: list + shortfall + alternatives
    UI-->>User: show trade-offs for confirmation
  end
