  <element>
    <id>Text</id>
    <coordinates>
      <x>20</x>
      <y>10</y>
      <w>1092</w>
      <h>30</h>
    </coordinates>
    <panel_attributes>fontsize=16
*MealIQ - Class Diagram: Architecture, Agent, and Integrations*</panel_attributes>
    <additional_attributes></additional_attributes>
  </element>
  <element>
    <id>Text</id>
    <coordinates>
      <x>20</x>
      <y>40</y>
      <w>1092</w>
      <h>24</h>
    </coordinates>
    <panel_attributes>Presentation boundary, shared facade and controller, AI agent with tools and memory, provider-neutral LLM access, and recipe/price data adapters (Facade, Adapter, Strategy client).</panel_attributes>
    <additional_attributes></additional_attributes>
  </element>
  <element>
    <id>UMLNote</id>
    <coordinates>
      <x>20</x>
      <y>90</y>
      <w>630</w>
      <h>114</h>
    </coordinates>
    <panel_attributes>*Notation*
Fill colour = package (responsibility area); dashed border = class detailed in another view
«interface» + italic name = interface;  italic operation = abstract
Solid line + hollow triangle = generalization;  dashed line + hollow triangle = realization
Solid open arrow = navigable association;  dashed open arrow = dependency («create» = instantiates)
Filled diamond = composition;  hollow diamond = aggregation;  [0..1] = optional
bg=#FFFFFF</panel_attributes>
    <additional_attributes></additional_attributes>
  </element>
  <element>
    <id>UMLClass</id>
    <coordinates>
      <x>950</x>
      <y>130</y>
      <w>380</w>
      <h>130</h>
    </coordinates>
    <panel_attributes>«boundary»
*MealPlanningGUI*
--
-apiBaseUrl: String
--
+submitRequest(request: PlanRequest): void
+showPlan(response: AgentResponse): void
+showChangePreview(change: PlanChange): void
+showGroceryList(list: GroceryList, status: BudgetStatus): void
bg=#DCEBF7</panel_attributes>
    <additional_attributes></additional_attributes>
  </element>
  <element>
    <id>UMLClass</id>
    <coordinates>
      <x>1420</x>
      <y>130</y>
      <w>330</w>
      <h>120</h>
    </coordinates>
    <panel_attributes>«boundary»
*MealPlanningCLI*
--
-facade: MealPlanningFacade
--
+executeCommand(args: List&lt;String&gt;): int
+printResult(response: AgentResponse): void
+promptConfirmation(change: PlanChange): boolean
bg=#DCEBF7</panel_attributes>
    <additional_attributes></additional_attributes>
  </element>
  <element>
    <id>UMLClass</id>
    <coordinates>
      <x>920</x>
      <y>310</y>
      <w>440</w>
      <h>160</h>
    </coordinates>
    <panel_attributes>«boundary»
*MealPlanningApi*
--
-facade: MealPlanningFacade
--
+postPlan(request: PlanRequest): AgentResponse
+postPlanChange(planId: UUID, instruction: String): AgentResponse
+postConfirmation(planId: UUID, change: PlanChange): AgentResponse
+putPantryItem(profileId: UUID, item: PantryItem): AgentResponse
+postAdaptation(planId: UUID): AgentResponse
+getGroceryList(planId: UUID): AgentResponse
bg=#DCEBF7</panel_attributes>
    <additional_attributes></additional_attributes>
  </element>
  <element>
    <id>UMLClass</id>
    <coordinates>
      <x>860</x>
      <y>570</y>
      <w>440</w>
      <h>310</h>
    </coordinates>
    <panel_attributes>«facade»
*MealPlanningFacade*
--
-agentController: AgentController
-profileService: ProfileService
-pantryService: PantryService
-mealPlanService: MealPlanService
-nutritionService: NutritionService
-groceryService: GroceryService
-budgetService: BudgetService
--
+updateProfile(profile: UserProfile): UserProfile
+updatePantry(profileId: UUID, item: PantryItem): AgentResponse
+recommendRecipe(query: RecipeQuery): AgentResponse
+generateWeeklyPlan(request: PlanRequest): AgentResponse
+analyzeNutrition(planId: UUID): NutritionSummary
+generateOptimizedGroceryList(planId: UUID): AgentResponse
+requestSubstitution(planId: UUID, ingredientId: UUID): AgentResponse
+modifyPlan(planId: UUID, instruction: String): AgentResponse
+adaptPlan(planId: UUID): AgentResponse
+executeChange(planId: UUID, change: PlanChange): AgentResponse
