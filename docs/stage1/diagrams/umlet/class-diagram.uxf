    <panel_attributes>«facade»
*MealPlanningFacade*
--
-agentController: AgentController
-profileService: ProfileService
-pantryService: PantryService
-mealPlanService: MealPlanService
-nutritionService: NutritionService
-groceryService: GroceryService
-budgetService: BudgetService
-pendingUpdates: Map&lt;UUID, Runnable&gt;
--
+fromConfig(config: AppConfig): MealPlanningFacade
+updateProfile(profile: UserProfile): UserProfile
+updatePantry(profileId: UUID, item: PantryItem): AgentResponse
+matchIngredients(text: String): List&lt;Ingredient&gt;
+recommendRecipe(profileId: UUID, request: String, filters: RecipeQuery, mode: PlanningMode): AgentResponse
+generateRecipe(profileId: UUID, request: String, filters: RecipeQuery): AgentResponse
+generateWeeklyPlan(request: PlanRequest): AgentResponse
+analyzeNutrition(planId: UUID): NutritionSummary
+generateOptimizedGroceryList(profileId: UUID): AgentResponse
+suggestCheaperPlan(profileId: UUID): AgentResponse
+requestSubstitution(profileId: UUID, ingredientName: String): AgentResponse
+modifyPlan(profileId: UUID, instruction: String, mode: PlanningMode): AgentResponse
+adaptPlan(profileId: UUID): AgentResponse
+executeChange(planId: UUID, change: PlanChange): AgentResponse
+undoLastChange(profileId: UUID): AgentResponse
+ask(profileId: UUID, message: String): AssistantReply
+confirmUpdate(profileId: UUID, updateId: UUID): AgentResponse
+checkup(profileId: UUID): Checkup
(read helpers such as getActivePlan, browseRecipes, recipeCost omitted)
bg=#D5E8D4</panel_attributes>
