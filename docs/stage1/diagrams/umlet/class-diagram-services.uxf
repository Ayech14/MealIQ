  <element>
    <id>UMLNote</id>
    <coordinates>
      <x>20</x>
      <y>90</y>
      <w>630</w>
      <h>114</h>
    </coordinates>
    <panel_attributes>*Notation*
Fill colour = package (responsibility area); dashed border = class detailed in another view
«interface» + italic name = interface;  italic operation = abstract
Solid line + hollow triangle = generalization;  dashed line + hollow triangle = realization
Solid open arrow = navigable association;  dashed open arrow = dependency («create» = instantiates)
Filled diamond = composition;  hollow diamond = aggregation;  [0..1] = optional
bg=#FFFFFF</panel_attributes>
    <additional_attributes />
  </element>
