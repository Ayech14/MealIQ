  </element>
  <element>
    <id>Text</id>
    <coordinates>
      <x>20</x>
      <y>40</y>
      <w>1626</w>
      <h>24</h>
    </coordinates>
    <panel_attributes>Every class, interface, attribute, operation, and relationship in one model. Focused, larger views: class-diagram.uxf (architecture), class-diagram-services.uxf (services and patterns), class-diagram-domain.uxf (domain), class-diagram-values.uxf (contracts and persistence).</panel_attributes>
    <additional_attributes></additional_attributes>
  </element>
  <element>
    <id>UMLNote</id>
    <coordinates>
      <x>20</x>
      <y>90</y>
      <w>630</w>
      <h>114</h>
    </coordinates>
    <panel_attributes>*Notation*
Fill colour = package (responsibility area)
«interface» + italic name = interface;  italic operation = abstract
Solid line + hollow triangle = generalization;  dashed line + hollow triangle = realization
Solid open arrow = navigable association;  dashed open arrow = dependency («create» = instantiates)
Filled diamond = composition;  hollow diamond = aggregation;  [0..1] = optional
bg=#FFFFFF</panel_attributes>
    <additional_attributes></additional_attributes>
  </element>
  <element>
    <id>UMLClass</id>
    <coordinates>
      <x>2400</x>
      <y>130</y>
      <w>460</w>
      <h>90</h>
    </coordinates>
    <panel_attributes>«interface»
*/PlanningStrategy/*
--
--
+configure(profile: UserProfile): void
+rank(candidates: List&lt;Recipe&gt;, context: PlanningContext): List&lt;Recipe&gt;
bg=#FCE4D6</panel_attributes>
    <additional_attributes></additional_attributes>
  </element>
  <element>
    <id>UMLClass</id>
    <coordinates>
      <x>3530</x>
      <y>130</y>
      <w>350</w>
      <h>90</h>
    </coordinates>
    <panel_attributes>«creator»
*/PlanningStrategyFactory/*
--
--
+strategyFor(context: PlanningContext): PlanningStrategy
/#createStrategy(mode: PlanningMode): PlanningStrategy/
bg=#FCE4D6</panel_attributes>
    <additional_attributes></additional_attributes>
