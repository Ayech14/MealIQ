    <panel_attributes>«agent»
*MealPlanningAgent*
--
-llmClient: LLMClient
-toolManager: ToolManager
-promptBuilder: PromptBuilder
-memory: ConversationMemory
-strategyFactory: PlanningStrategyFactory
-ingredientRepository: IngredientRepository
-maxToolSteps: int
--
+createPlanProposal(context: PlanningContext): PlanAttempt
+recommendRecipes(context: PlanningContext, filters: RecipeQuery): RecipeRecommendation
+rankRecipes(candidates: List&lt;Recipe&gt;, context: PlanningContext): List&lt;Recipe&gt;
+generateRecipe(context: PlanningContext, query: RecipeQuery): RecipeDraft
+proposeChange(context: PlanningContext, instruction: String): ChangeAttempt
+proposeSubstitution(context: PlanningContext, targets: List&lt;Ingredient&gt;): ChangeAttempt
+proposeAdaptation(context: PlanningContext, impact: PlanImpact): ChangeAttempt
+interpretRequest(context: PlanningContext, message: String): AssistantRequest
+recordDecision(profileId: UUID, decision: String): void
~runToolLoop(context: PlanningContext, goal: String, filters: RecipeQuery, recalled: List&lt;String&gt;): List&lt;ToolCall&gt;
bg=#E2F0D9</panel_attributes>
