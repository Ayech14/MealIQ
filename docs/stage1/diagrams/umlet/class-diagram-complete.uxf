    <panel_attributes>«controller»
*AgentController*
--
-agent: MealPlanningAgent
-profileService: ProfileService
-pantryService: PantryService
-mealPlanService: MealPlanService
-groceryService: GroceryService
-proposalValidator: ProposalValidator
-constraintValidator: ConstraintValidator
-portionService: PortionService
-pendingChanges: Map&lt;UUID, PlanChange&gt;
-pendingRecipes: Map&lt;UUID, Recipe&gt;
--
+generateWeeklyPlan(request: PlanRequest): AgentResponse
+recommendRecipe(request: PlanRequest, filters: RecipeQuery): AgentResponse
+generateRecipe(request: PlanRequest, query: RecipeQuery): AgentResponse
+interpretRequest(profileId: UUID, message: String, today: LocalDate): AssistantRequest
+interpretModification(plan: MealPlan, instruction: String, mode: PlanningMode): AgentResponse
+requestSubstitution(plan: MealPlan, ingredient: Ingredient): AgentResponse
+resolveBudgetConflict(plan: MealPlan, status: BudgetStatus): AgentResponse
+adaptPlan(plan: MealPlan, impact: PlanImpact): AgentResponse
+confirmChange(planId: UUID, change: PlanChange): AgentResponse
-buildContext(request: PlanRequest): PlanningContext
bg=#D5E8D4</panel_attributes>
    <additional_attributes />
  </element>
