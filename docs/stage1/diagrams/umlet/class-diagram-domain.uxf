*PantryItem*
--
-ingredient: Ingredient
-quantity: Quantity
-expiryDate: LocalDate [0..1]
--
+isExpired(on: LocalDate): boolean
bg=#FFF8E1</panel_attributes>
    <additional_attributes />
  </element>
