  <element>
    <id>Text</id>
    <coordinates>
      <x>20</x>
      <y>40</y>
      <w>1300</w>
      <h>24</h>
    </coordinates>
    <panel_attributes>Profile, pantry, recipe, meal-plan, grocery, nutrition, cost, change-history and budget types with their compositions, associations, multiplicities, and enumerations (Java records shown as «record»).</panel_attributes>
    <additional_attributes />
  </element>
  <element>
    <id>UMLNote</id>
    <coordinates>
      <x>20</x>
      <y>90</y>
      <w>630</w>
      <h>114</h>
    </coordinates>
    <panel_attributes>*Notation*
Fill colour = package (responsibility area)
«interface» + italic name = interface;  italic operation = abstract
Solid line + hollow triangle = generalization;  dashed line + hollow triangle = realization
Solid open arrow = navigable association;  dashed open arrow = dependency («create» = instantiates)
Filled diamond = composition;  hollow diamond = aggregation;  [0..1] = optional
bg=#FFFFFF</panel_attributes>
    <additional_attributes />
  </element>
  <element>
    <id>UMLClass</id>
    <coordinates>
      <x>40</x>
      <y>300</y>
      <w>310</w>
      <h>250</h>
    </coordinates>
    <panel_attributes>*UserProfile*
--
-id: UUID
-goal: WeightGoal
-dailyCalorieTarget: Integer [0..1]
-dailyProteinTargetG: Integer [0..1]
-dietaryRestrictions: Set&lt;String&gt;
-allergies: Set&lt;String&gt;
-dislikedFoods: Set&lt;String&gt;
-preferredFoods: Set&lt;String&gt;
-mealsPerDay: int
-weeklyBudget: BigDecimal
-maxCookMinutes: Map&lt;DayOfWeek, Integer&gt;
--
+isAllowed(ingredient: Ingredient): boolean
+maxMinutesFor(day: DayOfWeek): int [0..1]
bg=#FFF8E1</panel_attributes>
    <additional_attributes />
  </element>
  <element>
    <id>UMLClass</id>
    <coordinates>
      <x>450</x>
      <y>300</y>
      <w>490</w>
      <h>180</h>
    </coordinates>
    <panel_attributes>*Pantry*
--
-id: UUID
-profileId: UUID
-items: Map&lt;UUID, PantryItem&gt;
--
+availableQuantity(ingredient: Ingredient, on: LocalDate): Quantity
+shortfall(requirement: IngredientRequirement, on: LocalDate): Quantity
+take(requirement: IngredientRequirement, on: LocalDate): Quantity
+updateItem(item: PantryItem): void
+removeItem(ingredientId: UUID): void
bg=#FFF8E1</panel_attributes>
    <additional_attributes />
  </element>
