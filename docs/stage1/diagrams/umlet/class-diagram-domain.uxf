*Quantity*
--
-amount: double
-unit: Unit
--
+convertTo(unit: Unit): Quantity
+add(other: Quantity): Quantity
+subtract(other: Quantity): Quantity
+simplified(): Quantity
bg=#FFF8E1</panel_attributes>
