classDiagram
  class MealPlanningGUI { +submitRequest() +showPlan() +showGroceryList() }
  class MealPlanningCLI { +executeCommand() +printResult() }
  class MealPlanningFacade { +updateProfile(profile) +updatePantry(item) +recommendRecipe(criteria) +generateWeeklyPlan(request) +analyzeNutrition(target) +generateOptimizedGroceryList(planId) +modifyPlan(planId,instruction) +adaptPlan(planId,event) +executeChange(planId,change) }
  class AgentController { +recommendRecipe(criteria) +generateWeeklyPlan(request) +interpretModification(plan,instruction) +adaptPlan(plan,event) }
  class MealPlanningAgent { +createPlanProposal(context) PlanningProposal +rankRecipes(candidates,context) +proposeChange(context,instruction) PlanChange +proposeAdaptation(context,impact) }
  class PromptBuilder { +buildPlanningPrompt(context) +buildChangePrompt(context,instruction) }
  class ConversationMemory { +retrieveRelevantContext(profileId) +recordDecision(decision) }
  class ToolManager { +execute(toolName,request) ToolResult }
  class RecipeTool { +searchRecipes(criteria) List~RecipeCandidate~ }
  class NutritionTool { +analyze(target) NutritionSummary }
  class GroceryTool { +project(plan,pantry) GroceryList }
  class SubstitutionTool { +findCandidates(ingredient,context) List~Substitution~ }
  class LLMClient { <<interface>> +generateStructured(prompt,schema) StructuredResponse }
  class ProviderLLMAdapter { +generateStructured(prompt,schema) StructuredResponse +mapProviderError(error) LLMError }
  class ExternalLLMProviderAPI { <<external API/SDK>> +createStructuredResponse(request) ProviderResponse }
  class RecipeDataSource { <<interface>> +find(criteria) List~Recipe~ }
  class ExternalRecipeAdapter { +find(criteria) List~Recipe~ }
  class PlanningStrategy { <<interface>> +rank(candidates,context) List~RecipeCandidate~ }
  class NutritionGoalStrategy { +rank(candidates,context) List~RecipeCandidate~ }
  class BudgetStrategy { +rank(candidates,context) List~RecipeCandidate~ }
  class TimeAwareStrategy { +rank(candidates,context) List~RecipeCandidate~ }
  class PlanningStrategyFactory { <<abstract creator>> +createStrategy(mode) PlanningStrategy }
  class DefaultPlanningStrategyFactory { <<concrete creator>> +createStrategy(mode) PlanningStrategy }
  class ProposalValidator { +validate(proposal,context) ValidationResult }
  class ConstraintValidator { +validatePlan(plan,context) ValidationResult +validateTime(recipe,limit) ValidationResult +validateRestrictions(recipe,profile) ValidationResult }
  class ProfileService { +updateProfile(profile) +getProfile(profileId) }
  class PantryService { +updateItem(profileId,item) +removeItem(profileId,itemId) +getPantry(profileId) }
  class MealPlanService { +createFromProposal(proposal) MealPlan +executeChange(plan,command) +undoChange(plan,command) +assessImpact(plan,event) PlanImpact }
  class NutritionService { +calculateNutrition(target) NutritionSummary }
  class GroceryService { +generateList(plan,pantry) GroceryList +optimizeList(list,prices) GroceryList +markAffectedListStale(event) }
  class BudgetService { +evaluate(list,budget) BudgetStatus }
  class PlanRelevantChangePublisher { <<interface>> +subscribe(observer) +publish(event) }
  class PlanImpactObserver { <<interface>> +onPlanRelevantChange(event) }
  class MealPlanImpactObserver { +onPlanRelevantChange(event) }
  class GroceryListImpactObserver { +onPlanRelevantChange(event) }
  class PlanChangeCommand { <<interface>> +execute(plan) +undo(plan) }
  class ReplaceMealCommand { +execute(plan) +undo(plan) }
  class SubstituteIngredientCommand { +execute(plan) +undo(plan) }
  class UpdatePlanConstraintCommand { +execute(plan) +undo(plan) }
  class UserProfile { +profileId: UUID +weightGoal: WeightGoal +nutritionTargets: NutritionTarget +restrictions: Set +allergies: Set +dislikedFoods: Set +preferredFoods: Set +mealsPerDay: int +budget: Money +dailyTimeLimits: Map }
  class Ingredient { +ingredientId: UUID +name: String +category: String }
  class IngredientRequirement { +ingredient: Ingredient +quantity: Quantity +unit: Unit }
  class NutritionSummary { +calories: decimal +proteinGrams: decimal +carbohydrateGrams: decimal +fatGrams: decimal +complete: boolean }
  class Quantity { +amount: decimal +unit: Unit }
  class BudgetStatus { +estimatedCost: Money +budget: Money +shortfall: Money +withinBudget: boolean }
  class PlanImpact { +affectedMeals: List~PlannedMeal~ +affectedGroceryItems: List~GroceryItem~ +conflicts: List }
  class Pantry { +items: List~PantryItem~ +availableQuantity(ingredient) Quantity }
  class PantryItem { +ingredient: Ingredient +quantity: Quantity +expiryDate: Date }
  class Recipe { +recipeId: UUID +ingredients: List~IngredientRequirement~ +minutes: int +nutrition: NutritionSummary }
  class MealPlan { +planId: UUID +startDate: Date +meals: List~PlannedMeal~ +status: PlanStatus +replaceMeal(slot,recipe) }
  class PlannedMeal { +date: Date +mealType: MealType +recipe: Recipe +servings: int }
  class GroceryList { +items: List~GroceryItem~ +estimatedCost: Money }
  class GroceryItem { +ingredient: Ingredient +required: Quantity +toBuy: Quantity +estimatedPrice: Money }
  class ProfileRepository { <<interface>> +save(profile) +findById(id) }
  class PantryRepository { <<interface>> +save(pantry) +findByProfileId(id) }
  class RecipeRepository { <<interface>> +search(criteria) }
  class MealPlanRepository { <<interface>> +save(plan) +findActiveByProfileId(id) }
  class PlanningProposal { +meals: List~PlannedMeal~ +rationale: String +conflicts: List }
  class PlanChange { +target: MealSlot +changeType: ChangeType +proposal: Object }
  class PlanRelevantChange { +type: ChangeType +profileId: UUID +details: Object }

  MealPlanningGUI --> MealPlanningFacade
  MealPlanningCLI --> MealPlanningFacade
  MealPlanningFacade --> AgentController
  MealPlanningFacade --> ProfileService
  MealPlanningFacade --> PantryService
  MealPlanningFacade --> MealPlanService
  MealPlanningFacade --> GroceryService
  AgentController --> MealPlanningAgent
  AgentController --> MealPlanService
  MealPlanningAgent --> PromptBuilder
  MealPlanningAgent --> ConversationMemory
  MealPlanningAgent --> ToolManager
  MealPlanningAgent --> LLMClient
  MealPlanningAgent --> PlanningStrategyFactory
  ProviderLLMAdapter ..|> LLMClient
  ProviderLLMAdapter --> ExternalLLMProviderAPI : invokes
  ExternalRecipeAdapter ..|> RecipeDataSource
  ToolManager --> RecipeTool
  ToolManager --> NutritionTool
  ToolManager --> GroceryTool
  ToolManager --> SubstitutionTool
  RecipeTool --> RecipeRepository
  RecipeTool --> RecipeDataSource
  NutritionTool --> NutritionService
  GroceryTool --> GroceryService
  SubstitutionTool --> RecipeRepository
  DefaultPlanningStrategyFactory ..|> PlanningStrategyFactory
  DefaultPlanningStrategyFactory ..> NutritionGoalStrategy : creates
  DefaultPlanningStrategyFactory ..> BudgetStrategy : creates
  DefaultPlanningStrategyFactory ..> TimeAwareStrategy : creates
  NutritionGoalStrategy ..|> PlanningStrategy
  BudgetStrategy ..|> PlanningStrategy
  TimeAwareStrategy ..|> PlanningStrategy
  MealPlanService --> ProposalValidator
  MealPlanService --> ConstraintValidator
  MealPlanService --> MealPlanRepository
  NutritionService --> RecipeRepository
  GroceryService --> BudgetService
  GroceryService --> PantryRepository
  ProfileService --> ProfileRepository
  PantryService --> PantryRepository
  PantryService ..|> PlanRelevantChangePublisher
  ProfileService ..|> PlanRelevantChangePublisher
  MealPlanImpactObserver ..|> PlanImpactObserver
  GroceryListImpactObserver ..|> PlanImpactObserver
  MealPlanImpactObserver --> MealPlanService : assesses impact
  MealPlanImpactObserver --> AgentController : requests adaptation
  GroceryListImpactObserver --> GroceryService : marks stale
  PlanRelevantChangePublisher --> PlanImpactObserver : notifies
  ReplaceMealCommand ..|> PlanChangeCommand
  SubstituteIngredientCommand ..|> PlanChangeCommand
  UpdatePlanConstraintCommand ..|> PlanChangeCommand
  MealPlanService --> PlanChangeCommand
  UserProfile "1" *-- "1" Pantry
  Pantry "1" *-- "0..*" PantryItem
  PantryItem --> "1" Ingredient
  Recipe "1" *-- "1..*" IngredientRequirement
  IngredientRequirement --> "1" Ingredient
  Recipe --> "1" NutritionSummary
  MealPlan "1" *-- "1..*" PlannedMeal
  PlannedMeal "1" --> "1" Recipe
  GroceryList "1" *-- "0..*" GroceryItem
  GroceryItem --> "1" Ingredient
  MealPlan "1" --> "0..1" GroceryList
